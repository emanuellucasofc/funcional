# ============================================
# SUPABASE — PostgreSQL
# ============================================
# Vá em: https://supabase.com → seu projeto → Settings → Database
#
# DATABASE_URL  → "Transaction mode" (pooler) — porta 6543
#   Formato: postgresql://postgres.XXXX:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL    → "Session mode" (direto) — porta 5432
#   Formato: postgresql://postgres.XXXX:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#
# Ou use a connection string direta (sem pooler):
#   postgresql://postgres:[SENHA]@db.XXXX.supabase.co:5432/postgres

DATABASE_URL="postgresql://postgres.XXXX:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================
# JWT e Servidor
# ============================================
JWT_SECRET="funcional-super-secret-jwt-key-2026-change-in-production"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
